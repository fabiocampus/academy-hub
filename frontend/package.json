{
  "name": "academy-hub-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "anteprima": "vite preview",
    "api:genera": "openapi-typescript ../backend/contratto/openapi.json -o src/api/schema.d.ts",
    "lint": "eslint . --max-warnings 0",
    "formato": "prettier --check .",
    "formatta": "prettier --write .",
    "tipi": "tsc --noEmit",
    "test": "vitest run",
    "test:guarda": "vitest"
  },
  "dependencies": {
    "@mantine/core": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "@tanstack/react-query": "5.107.1",
    "oidc-client-ts": "3.5.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-oidc-context": "3.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "msw": "3.0.5",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.33",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
