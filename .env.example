# Copia in .env solo se vuoi cambiare i valori predefiniti: docker compose
# funziona anche senza. Solo valori di sviluppo, mai credenziali reali.

# PostgreSQL locale
POSTGRES_USER=academy
POSTGRES_PASSWORD=academy
POSTGRES_DB=academy
POSTGRES_PORT=5432

# Keycloak (amministratore della console, solo in locale)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080

# Grafana (otel-lgtm)
GRAFANA_PORT=3000

# Backend (prefisso ACADEMY_: letto da academy_hub.config)
BACKEND_PORT=8000
ACADEMY_AMBIENTE=locale
# Header X-Persona-Id al posto del token (fino alla fase 6). Falso se assente;
# l'app rifiuta di partire se è vero con un ambiente diverso da locale.
ACADEMY_IDENTITA_PROVVISORIA=true
ACADEMY_LIVELLO_LOG=INFO
# R5: un'iscrizione Confermata si annulla solo se mancano più di N giorni all'inizio.
ACADEMY_SCADENZA_ANNULLAMENTO_GIORNI=3
# Job di sistema (ADR-0007): secondi fra una passata e l'altra del servizio "job".
ACADEMY_JOB_OGNI_SECONDI=300
# Per il backend lanciato fuori da compose (uv run uvicorn ...): host localhost.
# Dentro compose l'URL lo costruisce docker-compose.yml con l'host "db".
ACADEMY_DATABASE_URL=postgresql+psycopg://academy:academy@localhost:5432/academy
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
