    "description": "Iscrizioni ai corsi dell'Academy. Errori in formato RFC 9457.",
    "title": "Academy Hub",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/catalogo": {
      "get": {
        "operationId": "consultaCatalogo",
        "parameters": [
          {
            "description": "Parte del titolo",
            "in": "query",
            "name": "titolo",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Parte del titolo",
              "title": "Titolo"
            }
          },
          {
            "description": "Inizio non prima di",
            "in": "query",
            "name": "dal",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inizio non prima di",
              "title": "Dal"
            }
          },
          {
            "description": "Inizio non dopo",
            "in": "query",
            "name": "al",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inizio non dopo",
              "title": "Al"
            }
          },
          {
            "in": "query",
            "name": "limite",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limite",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "description": "Identità provvisoria della fase 5, accettata solo in ambiente locale. Dalla fase 6 l'identità arriva dal token OIDC.",
            "in": "header",
            "name": "x-persona-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Identità provvisoria della fase 5, accettata solo in ambiente locale. Dalla fase 6 l'identità arriva dal token OIDC.",
              "title": "X-Persona-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaCatalogo"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Consulta Catalogo",
        "tags": [
          "catalogo"
        ]
      }
    },
